# Copiar a .env.local y completar. NUNCA commitear .env.local.
#
# Solo van variables PÚBLICAS (prefijo VITE_): quedan visibles en el navegador.
# La service_role key NO va acá: vive únicamente en las Edge Functions / secrets de Supabase.

# Proyecto Supabase local (supabase start) o el de producción
VITE_SUPABASE_URL=http://127.0.0.1:54321
# anon / publishable key (la muestra `supabase status`)
VITE_SUPABASE_ANON_KEY=
